# Copy to .env and set real values. Do not commit .env.
# Prefer an existing credentials file; select its profile with S3_PROFILE below.
# On the archive VM, for example: /home/ubuntu/.aws/credentials
S3_CREDENTIALS_SOURCE=
# Alternatively leave S3_CREDENTIALS_SOURCE empty and set both keys here.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.cl4.du.cesnet.cz
S3_DESTINATION=s3://xman-coinjoin-new/bitcoin-mainnet/blocks
S3_PROFILE=coinjoin
# Published images; latest follows the most recent default-branch publication.
ARCHIVER_IMAGE=ghcr.io/ondrejman/bitcoin-block-archive:latest
DUMPLINGS_IMAGE=ghcr.io/ondrejman/dumplings:latest
# Either Docker's named volume (the default) or an absolute host path, such as
# /mnt/bitcoin-data after running scripts/init-bitcoin-data-volume.sh.
BITCOIN_DATA_SOURCE=bitcoin-data
# Leave these empty for the named-volume default. For a host path owned by a
# local user, set them to `id -u USER` and `id -g USER` respectively. The
# archiver runs as the same user to read Core's private datadir.
BITCOIN_DATA_UID=
BITCOIN_DATA_GID=
# Bitcoin Core database cache in MiB. The default is 4 GiB.
BITCOIN_DBCACHE=4096
# Archiver flags after the fixed --block-dir and --state-dir. The default only
# uploads; pruning settings are below.
ARCHIVER_ARGS=--keep-latest-files 2
# How often the archiver repeats its pass (seconds, or 30m / 2h). 0 runs a
# single pass and exits.
ARCHIVE_INTERVAL=30m
# Pruning and txindex of Core. The default keeps every block and a txindex.
# Core refuses txindex with any pruning, so pruning means BITCOIN_PRUNE=1,
# BITCOIN_TXINDEX=0 and, with the Dumplings service, also capping pruning at
# Dumplings' progress:
# ARCHIVER_ARGS=--keep-latest-files 2 --prune-after-archive --prune-ceiling-file /dumplings/Scanner/LastProcessedBlockHeight.txt
BITCOIN_PRUNE=0
BITCOIN_TXINDEX=1
BITCOIN_RPC_WORK_QUEUE=16
# Dumplings service (`docker compose --profile dumplings up -d`): where its
# latest snapshot goes, seconds between passes and where Scanner/ lives
# (a named volume or an absolute host path).
DUMPLINGS_S3_DESTINATION=s3://xman-coinjoin-new/dumplings
DUMPLINGS_INTERVAL=86400
DUMPLINGS_DATA_SOURCE=dumplings-data
# Total memory limit; swap is disabled. Raise this if the scanner is OOM-killed.
DUMPLINGS_MEMORY_LIMIT=2g
# Optional small Core snapshot, invoked by bash core-backup.sh (e.g. daily cron).
# Skips unless manual pruning is active, IBD is finished, pruning reached within
# MAX_LAG blocks of the tip and the source fits BOTH size limits. Never enables
# pruning or deletes Core data. G means GiB. Staging needs another MAX_SIZE free.
CORE_BACKUP_DESTINATION=s3://xman-coinjoin-new/bitcoin-mainnet/core-snapshots
CORE_BACKUP_MAX_SIZE=25G
CORE_BACKUP_MAX_BLOCK_SIZE=2G
CORE_BACKUP_MAX_LAG=2016
