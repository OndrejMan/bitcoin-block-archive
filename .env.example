# Copy to .env and set real values. Do not commit .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.cl4.du.cesnet.cz
S3_DESTINATION=s3://xman-coinjoin/bitcoin-mainnet/blocks
S3_PROFILE=coinjoin
# Either Docker's named volume (the default) or an absolute host path, such as
# /mnt/bitcoin-data after running scripts/init-bitcoin-data-volume.sh.
BITCOIN_DATA_SOURCE=bitcoin-data
# Leave these as 0 for the named-volume default. For a host path owned by a
# local user, set them to `id -u USER` and `id -g USER` respectively.
BITCOIN_DATA_UID=0
BITCOIN_DATA_GID=0
