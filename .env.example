# Copy to .env and set real values. Do not commit .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.cl4.du.cesnet.cz
S3_DESTINATION=s3://xman-coinjoin-new/bitcoin-mainnet/blocks
S3_PROFILE=coinjoin
# Published images; latest follows the most recent default-branch publication.
ARCHIVER_IMAGE=ghcr.io/ondrejman/bitcoin-block-archive:latest
# Either Docker's named volume (the default) or an absolute host path, such as
# /mnt/bitcoin-data after running scripts/init-bitcoin-data-volume.sh.
BITCOIN_DATA_SOURCE=bitcoin-data
# Leave these empty for the named-volume default. For a host path owned by a
# local user, set them to `id -u USER` and `id -g USER` respectively. The
# archiver runs as the same user to read Core's private datadir.
BITCOIN_DATA_UID=
BITCOIN_DATA_GID=
# Bitcoin Core database cache in MiB. The default is 4 GiB.
BITCOIN_DBCACHE=4096
# Archiver flags after the fixed --block-dir and --state-dir. The default only
# uploads; pruning settings are below.
ARCHIVER_ARGS=--keep-latest-files 2
# How often the archiver repeats its pass (seconds, or 30m / 2h). 0 runs a
# single pass and exits.
ARCHIVE_INTERVAL=30m
# Pruning and txindex of Core. The default keeps every block and a txindex.
# Core refuses txindex with any pruning, so pruning means BITCOIN_PRUNE=1,
# BITCOIN_TXINDEX=0 and --prune-after-archive in ARCHIVER_ARGS.
BITCOIN_PRUNE=0
BITCOIN_TXINDEX=1
BITCOIN_RPC_WORK_QUEUE=16
